#!/bin/zsh
# yoto-addto <card code> "<card folder>" <file>… — add songs to a saved Yoto
# playlist, give them the card's icon and clean titles, then save. Needs
# yoto-serve running and the Yoto tab id in src/yoto-web/tabid.
[[ $1 == (-h|--help|) ]] && { sed -n '2,4p' ${0:A}; echo "usage: yoto-addto <card code> \"<card folder>\" <file>…"; exit 0 }
exec ${0:A:h:h}/src/yoto-web/addto.sh "$@"
