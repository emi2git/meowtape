#!/bin/zsh
# yjs <file.js | -e code>  → run JS in my own Yoto tab (id in ./tabid), print result
S=${0:A:h}; id=$(cat $S/tabid)
if [[ $1 == -e ]]; then js=$2; else js=$(cat "$1"); fi
osascript - "$js" "$id" <<'OSA'
on run argv
  set js to item 1 of argv
  set tid to (item 2 of argv) as integer
  tell application "Google Chrome"
    repeat with w in windows
      try
        return execute (tab id tid of w) javascript js
      end try
    end repeat
  end tell
  return "TAB GONE"
end run
OSA
